# CodeWhale 密钥模板
# ─────────────────────────────────────────────────────────────────────────────
# 用法（新机器 / 重装后）：
#   1. cp secrets.env.example secrets.env
#   2. 在 secrets.env 中填入你的真实密钥（等号后直接写，不要引号）
#   3. 运行仓库根目录的 ./codewhale-setup.sh —— 脚本会把密钥写入
#      ~/.codewhale/secrets/secrets.json（codewhale 的 secret store）
#
# secrets.env / secrets/secrets.json 均已被 .gitignore 忽略，不会上传 git。
# 模板文件 secrets.env.example 本身不含任何真实密钥，可以安全提交。
#
# 也可不填此文件，直接导出同名环境变量（查找顺序：config → secret store → env）。

# DeepSeek (deepseek)
DEEPSEEK_API_KEY=

# Xiaomi MiMo (xiaomi-mimo)
XIAOMI_MIMO_API_KEY=

# OpenAI 兼容 (openai)
OPENAI_API_KEY=

# opencode-go 供应商 (opencode-go)
OPENCODE_GO_API_KEY=

# opencode-zen 供应商 (opencode-zen)
OPENCODE_ZEN_API_KEY=
