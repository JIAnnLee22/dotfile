{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
     "opencode-cursor-oauth"
   ],
  "provider": {
    "cursor": {
      "name": "Cursor"
    },
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiMo",
      "options": {
        "baseURL": "https://api.xiaomimimo.com/v1",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "mimo-v2.5-pro": {
          "name": "mimo-v2.5-pro",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}