/* ============================================
   Waybar Flat Style — Light Frosted Glass
   ============================================ */

* {
    font-family: "Maple Mono NF CN", monospace;
    font-size: 18px;
    font-weight: 500;
    border: none;
    border-radius: 6px;
    min-height: 0;
}

window#waybar {
    background: rgba(245, 240, 232, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: none;
    margin: 8px;
    border-radius: 8px;
}

window#waybar > * {
    margin: 6px;
    margin-bottom: 0px;
}

window#waybar.hidden {
    opacity: 0.2;
}

button {
    border: none;
    background-color: transparent;
}

button:hover {
    background: inherit;
}

/* ============================================
   Workspaces
   ============================================ */
#workspaces {
    padding: 0;
    margin: 0;
}

#workspaces button {
    transition: none;
    padding: 0 4px;
    min-height: 0px;
    min-width: 28px;
    margin-left: 2px;
    background: transparent;
    color: rgba(60, 56, 54, 0.3);
    border-radius: 0;
}

#workspaces button:hover {
    background: transparent;
    color: rgba(60, 56, 54, 0.65);
}

#workspaces button.active {
    background: transparent;
    color: #3c6e5c;
}

#workspaces button.urgent {
    background: transparent;
    color: #cc3322;
}

/* ============================================
   Taskbar
   ============================================ */
#taskbar {
    padding: 0px;
    margin-left: 6px;
    margin-right: 6px;
}

#taskbar.empty {
    margin: 0;
    padding: 0;
    background-color: transparent;
}

#taskbar button {
    padding: 0 6px;
    min-width: 20px;
    background: transparent;
    color: rgba(60, 56, 54, 0.4);
    border-radius: 0;
    border-top: 2px solid transparent;
    padding-top: 4px;
}

#taskbar button.active {
    background: transparent;
    color: #3c3836;
    border-top: 2px solid #3c6e5c;
}

#taskbar button.minimized {
    background: transparent;
    color: rgba(160, 80, 100, 0.5);
    border-top: 2px solid transparent;
}

#taskbar button.urgent {
    background: transparent;
    color: #cc3322;
    border-top: 2px solid #cc3322;
}

/* ============================================
   Window title
   ============================================ */
#window {
    background: transparent;
    color: rgba(60, 56, 54, 0.55);
    padding: 0px 12px;
    border-radius: 0;
}

window#waybar.empty #window {
    background: none;
    margin: 0;
    padding: 0;
}

/* ============================================
   Modules — unified surface
   ============================================ */
#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#scratchpad,
#power-profiles-daemon,
#custom-notification,
#custom-power,
#keyboard-state,
#language,
#mpd {
    padding: 0px 8px;
    border-radius: 0;
    background: transparent;
    color: rgba(60, 56, 54, 0.65);
}

/* --- Accent states --- */

/* Power button */
#custom-power {
    font-family: "JetBrainsMono Nerd Font Propo", monospace;
    font-size: 18px;
    margin-left: 4px;
}

#custom-power:hover {
    color: #3c6e5c;
}

/* Clock */
#clock {
    color: #3c3836;
    padding-right: 12px;
}

/* Network */
#network {
    color: #3c6e5c;
}

#network.disconnected {
    color: #cc3322;
}

/* Temperature */
#temperature.critical {
    color: #cc3322;
}

/* Battery */
#battery.charging,
#battery.plugged {
    color: #3c6e5c;
}

@keyframes blink-battery-low {
    to {
        color: #cc3322;
    }
}

#battery.critical:not(.charging) {
    color: #cc3322;
    animation-name: blink-battery-low;
    animation-duration: 0.5s;
    animation-timing-function: steps(12);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

/* Pulseaudio muted */
#pulseaudio.muted {
    color: rgba(60, 56, 54, 0.4);
}

/* Power profiles */
#power-profiles-daemon.performance {
    color: #c45e1a;
}

#power-profiles-daemon.balanced {
    color: #3c6e5c;
}

#power-profiles-daemon.power-saver {
    color: #8a8518;
}

/* Tray */
#tray {
    background: transparent;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
}

/* Mode */
#mode {
    background: transparent;
    color: #cc3322;
}

/* ============================================
   Tooltip & Menu
   ============================================ */
tooltip {
    background-color: rgba(245, 240, 232, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: none;
    border-radius: 8px;
}

tooltip decoration {
    box-shadow: none;
}

tooltip decoration:backdrop {
    box-shadow: none;
}

tooltip label {
    color: #3c3836;
    padding: 3px 7px;
}

menu {
    border-width: 1px;
    border-style: solid;
    border-color: rgba(60, 56, 54, 0.3);
    background: rgba(245, 240, 232, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 8px;
}

menuitem {
    border-radius: 6px;
    color: #3c3836;
}

menuitem:hover {
    color: #faf8f5;
    background: #3c6e5c;
}

/* Workspaces margin handling */
.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

.modules-right > widget:last-child > #workspaces {
    margin-right: 0;
}
