# Mako - AMOLED 纯黑主题
# 链接到 ~/.config/mako/config

# 全局设置
sort=-time
layer=overlay
anchor=top-right
margin=20

# 外观
width=350
height=100
border-size=0
border-radius=20
background-color=rgba(0, 0, 0, 0.9)
text-color=#e0e0e0
padding=20
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0

# 字体
font=Inter, Noto Sans CJK SC, sans-serif 13

# 进度条样式
progress-color=over #bb86fc

[urgency=low]
background-color=rgba(0, 0, 0, 0.7)
border-color=#333333
default-timeout=3000

[urgency=normal]
background-color=rgba(0, 0, 0, 0.9)
border-color=#bb86fc
default-timeout=5000

[urgency=high]
background-color=rgba(0, 0, 0, 0.95)
border-color=#cf6679
border-size=2
default-timeout=0

# 特殊应用配置
[category=mpd]
default-timeout=2000
group-by=category

[app-name=Spotify]
background-color=rgba(30, 215, 96, 0.15)
border-color=#1ed760
default-timeout=3000

[app-name=Firefox]
background-color=rgba(255, 152, 0, 0.1)
border-color=#ff9800

# 组配置
[grouped]
mode=group
format=<b>%s</b>\n%b